  "item": [
    {
      "name": "01. Health & Autenticação Google (US1)",
      "description": "Etapa 1 do fluxo: verifica o status da API, autentica via Google ID Token emitindo o JWT Bearer (`{{access_token}}`) e consulta a sessão atual.",
      "item": [
        {
          "name": "1.1 Healthcheck / Status da API (GET /)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            }
          }
        },
        {
          "name": "1.2 Login via Google - Etapa 1 (POST /api/auth/google)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Authenticated via Google (200 or 201)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "var token = json.access_token || (json.data && json.data.access_token);",
                  "if (token) {",
                  "    pm.collectionVariables.set('access_token', token);",
                  "    console.log('access_token salvo automaticamente na collection!');",
                  "}",
                  "var user = json.user || (json.data && json.data.user);",
                  "if (user && user.public_id) {",
                  "    pm.collectionVariables.set('user_public_id', user.public_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "client_authentication",
                  "value": "body",
                  "type": "string"
                },
                {
                  "key": "scope",
                  "value": "openid email profile",
                  "type": "string"
                },
                {
                  "key": "clientSecret",
                  "value": "{{google_client_secret}}",
                  "type": "string"
                },
                {
                  "key": "clientId",
                  "value": "{{google_client_id}}",
                  "type": "string"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://oauth2.googleapis.com/token",
                  "type": "string"
                },
                {
                  "key": "authUrl",
                  "value": "https://accounts.google.com/o/oauth2/v2/auth",
                  "type": "string"
                },
                {
                  "key": "useBrowser",
                  "value": true,
                  "type": "boolean"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code",
                  "type": "string"
                },
                {
                  "key": "tokenName",
                  "value": "Google OIDC",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "google"
              ]
            },
            "description": "Autentica com o `id_token` do Google e salva automaticamente o `access_token` do Docffy na variável `{{access_token}}` da coleção."
          }
        },
        {
          "name": "1.3 Consultar Sessão / Perfil Atual (GET /api/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var creator = json.creator || (json.data && json.data.creator);",
                  "if (creator && creator.public_id) {",
                  "    pm.collectionVariables.set('creator_public_id', creator.public_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
