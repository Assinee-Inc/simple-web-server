      "type": "string"
    },
    {
      "key": "google_client_secret",
      "value": "",
      "type": "string"
    },
    {
      "key": "google_id_token",
      "value": "COLE_AQUI_O_ID_TOKEN_DO_GOOGLE",
      "type": "string"
    },
    {
