    {
      "name": "05. Clientes, Vendas e Transações (US3)",
      "description": "Gestão de clientes compradores, exportação CSV, histórico de vendas, bloqueio/desbloqueio de downloads e transações.",
      "item": [
        {
          "name": "5.1 Listar Clientes do Criador (GET /client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var clients = json.clients || (json.data && json.data.clients);",
                  "if (Array.isArray(clients) && clients.length > 0 && clients[0].public_id) {",
