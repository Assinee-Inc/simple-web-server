          "name": "4.1 Listar Arquivos do Criador (GET /file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "var files = json.files || (json.data && json.data.files);",
                  "if (Array.isArray(files) && files.length > 0 && files[0].public_id) {",
                  "    pm.collectionVariables.set('file_id', files[0].public_id);",
                  "}"
                ],
                "type": "text/javascript"
